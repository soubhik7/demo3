# ============================================================================
# 3PL Automation - Environment Variables Template
# ============================================================================
# SECURITY: Never commit actual credentials to version control
# Copy this file to .env.local and fill in real values
# ============================================================================

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Security Settings
ENABLE_RATE_LIMITING=true
MAX_REQUEST_SIZE=1048576
ENABLE_CSRF_PROTECTION=true

# ============================================================================
# BTP (Business Technology Platform) Configuration
# ============================================================================
# SECURITY: Store these in Azure Key Vault or AWS Secrets Manager in production

BTP_API_HOST=https://api.btp.example.com
BTP_TOKEN_URL=https://auth.btp.example.com/oauth/token
BTP_CLIENT_ID=your-client-id-here
BTP_CLIENT_SECRET=your-client-secret-here
BTP_PRODUCT_NAME=3PL-Integration
BTP_QUOTA_PLAN=standard
BTP_D3_APPROVER_EMAIL=approver@example.com

# BTP Suite Configuration
BTP_SUITE_BASE_URL=https://your-tenant.integrationsuite.cfapps.us21.hana.ondemand.com
BTP_VALUEMAP_ARTIFACT_ID=your-artifact-id
BTP_VALUEMAP_PACKAGE_ID=your-package-id

# ============================================================================
# Solace Event Portal Configuration
# ============================================================================
# SECURITY: API tokens should be rotated regularly

SOLACE_EP_API_TOKEN=your-solace-api-token-here
SOLACE_ENUM_ID=your-enum-id
SOLACE_EVENT_ID=your-event-id
SOLACE_PRODUCER_APP_ID=your-producer-app-id
SOLACE_PRODUCER_APP_NAME=petc-rc-mulesoft-producer
SOLACE_CONSUMER_APP_ID=your-consumer-app-id
SOLACE_CONSUMER_APP_NAME=petc-rc-navision-3plspl-consumer
SOLACE_ENVIRONMENT_ID=your-environment-id
SOLACE_BROKER_ID=your-broker-id

# Solace SEMP (Management) Configuration
SOLACE_SEMP_HOST=your-solace-host.messaging.solace.cloud
SOLACE_SEMP_PORT=943
SOLACE_SEMP_USERNAME=your-semp-username
SOLACE_SEMP_PASSWORD=your-semp-password
SOLACE_VPN_UAT=your-uat-vpn-name
SOLACE_VPN_PROD=your-prod-vpn-name
SOLACE_QUEUE_NAME=your-queue-name

# Solace Git Configuration
SOLACE_GITHUB_REPO_OWNER=your-org
SOLACE_GITHUB_REPO_NAME=solace-config
SOLACE_GITHUB_BASE_BRANCH=dev
SOLACE_INPUT_JSON_PATH=config/input.json

# ============================================================================
# MuleSoft Configuration
# ============================================================================

MULE_GITHUB_REPO_OWNER=your-org
MULE_GITHUB_REPO_NAME=mulesoft-integration
MULE_GITHUB_BASE_BRANCH=dev
MULE_REVIEWER_GITHUB_HANDLE=reviewer-username

# ============================================================================
# GitHub Configuration
# ============================================================================
# SECURITY: Use fine-grained personal access tokens with minimal permissions
# Required scopes: repo (for private repos) or public_repo (for public repos)

GITHUB_PAT=ghp_your_github_personal_access_token_here

# GitHub OAuth App — required for the Device Code login flow in the web UI
# Steps to create:
#   1. GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   2. Application name: 3PL Onboarding Automation
#   3. Homepage URL: http://localhost:3000 (or your Azure URL)
#   4. No Authorization callback URL needed for Device Flow
#   5. Enable "Device Authorization Flow" checkbox
#   6. Register App → copy the Client ID below (no client secret needed)
# See: https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps#device-flow
GITHUB_OAUTH_CLIENT_ID=Ov23liXXXXXXXXXXXXXX

# ============================================================================
# Notification Configuration
# ============================================================================
# Choose one: email, teams, or slack

NOTIFICATION_CHANNEL=email

# Email Configuration (if using email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USERNAME=smtp-user
SMTP_PASSWORD=smtp-password
REVIEWER_EMAIL=reviewer@example.com

# Microsoft Teams Configuration (if using Teams notifications)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# Slack Configuration (if using Slack notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url

# ============================================================================
# Authentication Configuration (TO BE IMPLEMENTED)
# ============================================================================
# SECURITY: These are placeholders for future authentication implementation

# JWT_SECRET=your-jwt-secret-here-min-32-chars
# JWT_EXPIRY=1h
# OAUTH_CLIENT_ID=your-oauth-client-id
# OAUTH_CLIENT_SECRET=your-oauth-client-secret
# OAUTH_ISSUER=https://your-auth-provider.com
# OAUTH_AUDIENCE=https://your-api.com

# ============================================================================
# Logging and Monitoring (TO BE IMPLEMENTED)
# ============================================================================

# LOG_LEVEL=info
# SIEM_ENDPOINT=https://your-siem.com/api/logs
# SIEM_API_KEY=your-siem-api-key

# ============================================================================
# Security Notes
# ============================================================================
# 1. Never commit .env.local or .env.production to version control
# 2. Rotate all secrets regularly (recommended: every 90 days)
# 3. Use different credentials for each environment (dev, uat, prod)
# 4. Store production secrets in a secure vault (Azure Key Vault, AWS Secrets Manager)
# 5. Limit access to secrets using principle of least privilege
# 6. Enable audit logging for all secret access
# 7. Use service accounts with minimal permissions
# 8. Monitor for unauthorized access attempts
# ============================================================================